# ==============================================================================
# ForgeWise AI (Vikrant 5.0)
# Configuration lives next to each app:
#   apps/api/.env        <- copy from apps/api/.env.example (MongoDB, JWT, LLM keys)
#   apps/web/.env.local  <- copy from apps/web/.env.example (proxy target, app name)
#
# This root file is only read by `docker compose` for variable substitution.
# ==============================================================================

# Host port for the MongoDB container
MONGO_PORT=27017

# Optional: Ollama running on the Docker host (free local models)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=
