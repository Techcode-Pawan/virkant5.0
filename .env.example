# ==============================================================================
# ForgeWise AI (Vikrant 5.0) — Unified Environment Configuration Template
# ==============================================================================
# Copy this file to .env for Docker Compose or service-specific .env files.
# NEVER commit real production API keys or service role secrets.

# ------------------------------------------------------------------------------
# General Platform Configuration
# ------------------------------------------------------------------------------
APPLICATION_ENV=development
APP_NAME="ForgeWise AI"
NEXT_PUBLIC_APP_NAME="ForgeWise AI"
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Network and Ports
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# Database & Cache (PostgreSQL + pgvector & Redis)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forgewise_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=forgewise_db
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Supabase Authentication & Storage (Optional Managed Provider)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-never-use-service-key-here
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-backend-only
SUPABASE_JWT_SECRET=placeholder-jwt-secret-for-local-token-verification
STORAGE_BUCKET=industrial-documents-private

# ------------------------------------------------------------------------------
# Multimodal Multi-LLM Providers (Gemini, OpenAI, Anthropic Claude, Ollama)
# ------------------------------------------------------------------------------
# Primary provider default: "gemini" | "openai" | "claude" | "ollama" | "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Legacy fallback key
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=2048

# Embedding Provider: "auto" | "gemini" | "openai" | "ollama" | "mock"
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=1536

# Vision / Schematic Analysis Provider
VISION_PROVIDER=gemini
VISION_API_KEY=
VISION_MODEL=gemini-2.5-flash

OCR_PROVIDER=tesseract
OCR_API_KEY=

# ------------------------------------------------------------------------------
# Storage & Upload Limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
UPLOAD_TEMP_DIR=./storage_data/temp
