# Copy to apps/web/.env.local. Only NEXT_PUBLIC_* values reach the browser — never put API keys here.
NEXT_PUBLIC_APP_NAME="ForgeWise AI"

# Server-side proxy target for /api/v1/* (used by `next dev` and `next start`).
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: call the backend directly from the browser instead of through the proxy
# (requires the origin to be listed in the backend's CORS_ALLOWED_ORIGINS). Leave empty to use the proxy.
NEXT_PUBLIC_API_BASE_URL=

# Optional: shows a mailto contact form on /contact
NEXT_PUBLIC_CONTACT_EMAIL=
