# ==============================================================================
# ForgeWise AI (Vikrant 5.0) — Backend configuration
# Copy to apps/api/.env and fill in. .env is git-ignored; never commit real keys.
# ==============================================================================

# development | production
APPLICATION_ENV=development
APP_NAME="ForgeWise AI"
PORT=8000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# MongoDB (required)
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=vikrant5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=50
# true = refuse to start without MongoDB; false = start degraded and return 503s
MONGODB_REQUIRED_ON_STARTUP=false

# ------------------------------------------------------------------------------
# Auth — generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production. If empty in development an ephemeral secret is used.
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# Lets the sign-in form choose a role (demo convenience). Set false in production.
ALLOW_ROLE_SELF_SELECT=true

# ------------------------------------------------------------------------------
# LLM providers — all optional. Configure one or more.
# Without any, chat still works in "offline extractive" mode (quotes your docs).
# ------------------------------------------------------------------------------
# Google Gemini (free tier available): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI or any OpenAI-compatible endpoint (Groq, OpenRouter, LM Studio, vLLM...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Ollama (free, local, no key): install from https://ollama.com then `ollama pull llama3.1:8b`
# Leave empty to disable.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# Model selection. Ids are listed at GET /api/v1/llm/models
# (e.g. gemini-2.5-flash, gpt-4o-mini, claude-haiku-5-5, ollama/llama3.1:8b).
# Empty primary = first configured provider (gemini → openai → anthropic → ollama).
LLM_PRIMARY_MODEL=
# Comma-separated. Empty = every other configured provider's default model.
LLM_FALLBACK_MODELS=
# Final safety net that quotes matching document passages verbatim (never invents text).
LLM_OFFLINE_FALLBACK=true

# Reliability
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_TOTAL_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.75
LLM_RETRY_MAX_DELAY_SECONDS=8
LLM_PROVIDER_COOLDOWN_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
CHAT_HISTORY_TURNS=12

# Embeddings for retrieval: local | auto | gemini | openai | ollama
# "local" is free/offline; "auto" uses Gemini or OpenAI when a key is present.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
OLLAMA_EMBED_MODEL=nomic-embed-text

# Image description during upload / chat photos: none | gemini | openai | anthropic
VISION_PROVIDER=none

# ------------------------------------------------------------------------------
# HTTP / storage
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
MAX_UPLOAD_SIZE_BYTES=52428800
STORAGE_DIR=storage
