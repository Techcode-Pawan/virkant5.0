APPLICATION_ENV=development
APP_NAME="ForgeWise AI"
PORT=8000
LOG_LEVEL=info

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forgewise_db
REDIS_URL=redis://localhost:6379/0

# Supabase Auth & Storage
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-backend-only
SUPABASE_JWT_SECRET=placeholder-jwt-secret-for-local-token-verification
STORAGE_BUCKET=industrial-documents-private

# AI Providers
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=2048

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

VISION_PROVIDER=mock
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini

OCR_PROVIDER=tesseract

# Security & CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
MAX_UPLOAD_SIZE_BYTES=52428800
